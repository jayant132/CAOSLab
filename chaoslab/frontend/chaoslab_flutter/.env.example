# Copy this file to `.env` before running the app.
#
# Base URL of the ChaosLab FastAPI backend.
# - Android emulator talking to a backend on your host machine: http://10.0.2.2:8000
# - iOS simulator / desktop / web: http://127.0.0.1:8000
# - Physical device: http://<your-computer-lan-ip>:8000
API_BASE_URL=http://127.0.0.1:8000
